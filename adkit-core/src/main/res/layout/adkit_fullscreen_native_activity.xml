<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adkit_surface"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/adkit_fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/adkit_fullscreen_close"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/adkit_skeleton_block"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:textColor="@color/adkit_text_primary"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>